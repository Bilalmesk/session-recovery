<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Session Recovery"
           Manufacturer="Bilalmesk"
           Version="$(var.ProductVersion)"
           UpgradeCode="{F5EB7542-42D4-46AC-AF74-084FD32DF210}"
           Scope="perUser"
           Language="1033"
           Codepage="1252"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Session Recovery is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="SessionRecoveryIcon" SourceFile="..\assets\SessionRecovery.ico" />

    <!-- Per-user installation: no UAC prompt and no files in Program Files.
         Scope="perUser" handles the install context. Do not set ALLUSERS or
         MSIINSTALLPERUSER here: they conflict with the UAC-limited package
         and make the ARP entry land in HKLM instead of HKCU. -->
    <Property Id="ARPPRODUCTICON" Value="SessionRecoveryIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Session Recovery is ready. Open it from the Start Menu or the desktop shortcut." />

    <!-- Remember a custom install folder so uninstall resolves the same path.
         Without this, Windows Installer falls back to the default per-user
         folder and leaves a custom-location install behind. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="InstallFolderSearch" Root="HKCU" Key="Software\SessionRecovery" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="MainFeature" Title="Session Recovery" Description="The Session Recovery Studio, background protection and restore tools." Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="ApplicationComponents" />
      <ComponentGroupRef Id="MenuComponents" />
      <ComponentGroupRef Id="StartupComponents" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop shortcut" Description="Create a Session Recovery icon on the desktop." Level="1">
      <ComponentGroupRef Id="DesktopShortcutComponents" />
    </Feature>

    <!-- FeatureTree gives the user a Browse button for the install folder
         and a checkbox for the optional desktop shortcut. -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
    <WixVariable Id="WixUIBannerBmp" Value="..\assets\installer-banner.bmp" />
    <WixVariable Id="WixUIDialogBmp" Value="..\assets\installer-dialog.bmp" />
  </Package>

  <Fragment>
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="SessionRecoveryRoot" Name="SessionRecovery">
        <Directory Id="INSTALLFOLDER" Name="app" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Session Recovery" />
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder" />
    <StandardDirectory Id="StartupFolder" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ApplicationComponents" Directory="INSTALLFOLDER">
      <Component Id="ApplicationFiles" Guid="{5A3CB50A-6C42-4154-AFE4-58B91F52662D}">
        <File Id="SessionRecoveryExe" Source="..\dist\SessionRecovery.exe" />
        <File Id="SessionRecoveryPsm1" Source="..\src\SessionRecovery.psm1" />
        <File Id="SaveSessionPs1" Source="..\src\Save-Session.ps1" />
        <File Id="RestoreSessionPs1" Source="..\src\Restore-Session.ps1" />
        <File Id="TrayAppPs1" Source="..\src\Tray-SessionRecovery.ps1" />
        <File Id="WatchSessionPs1" Source="..\src\Watch-Session.ps1" />
        <File Id="DiagnosticsPs1" Source="..\src\Diagnostics.ps1" />
        <File Id="RunHiddenVbs" Source="..\src\RunHidden.vbs" />
        <File Id="StudioPs1" Source="..\src\Studio-SessionRecovery.ps1" />
        <File Id="StringsPs1" Source="..\src\Strings.ps1" />
        <File Id="StudioThemePs1" Source="..\src\StudioTheme.ps1" />
        <File Id="StudioControlsCs" Source="..\src\StudioControls.cs" />
        <File Id="ControlSessionRecoveryPs1" Source="..\src\Control-SessionRecovery.ps1" />
        <File Id="BrandIconFile" Source="..\assets\SessionRecovery.ico" />
        <File Id="ReadmeMd" Source="..\README.md" />
        <!-- Scripts are unversioned and can be left behind by an older
             install or a manual copy. RemoveFiles runs before InstallFiles,
             so every upgrade replaces them instead of silently keeping old
             UI strings or an old capture engine. -->
        <RemoveFile Id="RemovePsm1" Name="SessionRecovery.psm1" On="install" />
        <RemoveFile Id="RemoveSaveSession" Name="Save-Session.ps1" On="install" />
        <RemoveFile Id="RemoveRestoreSession" Name="Restore-Session.ps1" On="install" />
        <RemoveFile Id="RemoveTrayApp" Name="Tray-SessionRecovery.ps1" On="install" />
        <RemoveFile Id="RemoveWatchSession" Name="Watch-Session.ps1" On="install" />
        <RemoveFile Id="RemoveDiagnostics" Name="Diagnostics.ps1" On="install" />
        <RemoveFile Id="RemoveRunHidden" Name="RunHidden.vbs" On="install" />
        <RemoveFile Id="RemoveStudio" Name="Studio-SessionRecovery.ps1" On="install" />
        <RemoveFile Id="RemoveStrings" Name="Strings.ps1" On="install" />
        <RemoveFile Id="RemoveStudioTheme" Name="StudioTheme.ps1" On="install" />
        <RemoveFile Id="RemoveStudioControls" Name="StudioControls.cs" On="install" />
        <RemoveFile Id="RemoveControlSessionRecovery" Name="Control-SessionRecovery.ps1" On="install" />
        <RemoveFile Id="RemoveBrandIcon" Name="SessionRecovery.ico" On="install" />
        <RemoveFile Id="RemoveReadme" Name="README.md" On="install" />
        <RegistryValue Root="HKCU" Key="Software\SessionRecovery\Components" Name="ApplicationFiles" Type="integer" Value="1" KeyPath="yes" />
        <RemoveFile Id="RemoveLegacyUninstaller" Name="Uninstall-SessionRecovery.ps1" On="install" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemoveSessionRecoveryRoot" Directory="SessionRecoveryRoot" On="uninstall" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="MenuComponents">
      <Component Id="StartMenuFolder" Directory="ApplicationProgramsFolder" Guid="{0F37F433-9778-4287-8642-DEFAD500FF08}">
        <CreateFolder />
        <RemoveFolder Id="RemoveStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\SessionRecovery" Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <RemoveRegistryKey Root="HKCU" Key="Software\SessionRecovery" Action="removeOnUninstall" />

        <Shortcut Id="StudioStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Session Recovery"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Open the Session Recovery Studio." />
        <Shortcut Id="TakeSnapshotStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Take Snapshot Now"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--snapshot"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Save a snapshot of the current windows and tabs right now." />
        <Shortcut Id="RestoreSessionStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Restore Session"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--restore-manual"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Reopen the windows and tabs from a saved session." />
        <Shortcut Id="RunInBackgroundStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Run in Background"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--tray"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Start the Session Recovery notification-area app." />
        <Shortcut Id="DiagnosticsStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Run Diagnostics"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--diagnostics"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Show a Session Recovery health report." />
        <Shortcut Id="UninstallStartMenu"
                  Directory="ApplicationProgramsFolder"
                  Name="Uninstall Session Recovery"
                  Icon="SessionRecoveryIcon"
                  Target="[SystemFolder]msiexec.exe"
                  Arguments="/x [ProductCode]"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Remove Session Recovery." />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="StartupComponents">
      <Component Id="StartupShortcuts" Directory="StartupFolder" Guid="{5B5C4737-FD7B-4014-9FA0-74D049DFBBE5}">
        <Shortcut Id="StartupBackgroundShortcut"
                  Directory="StartupFolder"
                  Name="Session Recovery - Background"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--tray"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Session Recovery: runs the notification-area app and keeps snapshots while you are logged on." />
        <Shortcut Id="StartupRestoreShortcut"
                  Directory="StartupFolder"
                  Name="Session Recovery - Restore Prompt"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  Arguments="--restore-prompt"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Session Recovery: shows the restore prompt after logon." />
        <RemoveFile Id="RemoveLegacyWatcherShortcut" Name="Session Recovery - Snapshot Watcher.lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\SessionRecovery\Components" Name="StartupShortcuts" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="DesktopShortcutComponents">
      <Component Id="DesktopShortcut" Directory="DesktopFolder" Guid="{D8A2B4C1-6E3F-4A2B-9C7D-5E1F2A3B4C6D}">
        <Shortcut Id="DesktopStudioShortcut"
                  Directory="DesktopFolder"
                  Name="Session Recovery"
                  Icon="SessionRecoveryIcon"
                  Target="[INSTALLFOLDER]SessionRecovery.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Description="Open the Session Recovery Studio." />
        <RemoveFile Id="RemoveLegacyRestoreDesktop" Name="Restore Session.lnk" On="install" />
        <RegistryValue Root="HKCU" Key="Software\SessionRecovery\Components" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
